rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is admin (case-insensitive)
    function isAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole == 'admin' || userRole == 'ADMIN';
    }
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Paramètres globaux lisibles en mode public (ex: page de login)
    match /settings/{document=**} {
      allow read: if true;
    }

    // All authenticated users can read everything
    match /{document=**} {
      allow read: if isAuthenticated();
    }
    
    // Admin can write to ALL collections
    match /{document=**} {
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Teachers can create/update grades for their classes
    match /grades/{gradeId} {
      allow create, update: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'prof';
    }
    
    // Any authenticated user can update their own profile
    match /users/{userId} {
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
