# ============================================================================
# Smart School — Backend (Express + MySQL)
# Copier en .env et remplir.  NE JAMAIS commiter le .env
# ============================================================================

# --- Serveur ---
NODE_ENV=development
PORT=3001

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartschool_db

# --- Sécurité ---
# Générer une valeur aléatoire forte (au moins 64 caractères).
# Exemple :  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Le serveur REFUSE de démarrer en production si cette variable n'est pas définie.
JWT_SECRET=change-me-in-production

# --- CORS ---
# Liste séparée par virgules des origines autorisées.
# En dev : http://localhost:3000  (port du frontend Vite)
# En prod : ajouter le domaine Vercel, ex: https://smartschool.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Google Gemini (OCR via Genkit) ---
# Obtenir une clé sur https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# --- Rate-limit /auth/login ---
# Tentatives de connexion autorisées par fenêtre (par IP).
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MIN=15
