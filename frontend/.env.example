# ============================================================================
# Smart School — Frontend (Vite + React)
# Copier en .env.local et adapter.  Vite ne charge que les VITE_*  côté client.
# ============================================================================

# URL publique du backend Smart School.
#
# - En dev : laisser vide pour utiliser le proxy Vite (vite.config.ts) qui
#            redirige /api/* vers http://localhost:3001.
# - En prod : pointer vers ton backend déployé (Render / Railway / VPS).
#   Exemple : https://smartschool-backend.up.railway.app
VITE_API_URL=
